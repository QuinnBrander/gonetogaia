{
  "name": "g2g",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host",
    "build:single": "tsc -p tsconfig.json --noEmit && vite build --config vite.singlefile.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "node scripts/qa.mjs",
    "package:exe": "tsc -p tsconfig.json --noEmit && vite build --mode portable && electron-builder --win portable"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "mupdf": "^1.27.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.gametotherescue.gonetogaia",
    "productName": "GonetoGaia",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "GonetoGaia.exe"
    }
  },
  "dependencies": {
    "firebase": "^13.3.0"
  }
}
